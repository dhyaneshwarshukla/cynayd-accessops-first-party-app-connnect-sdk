# AccessOps endpoint. Set one of ACCESSOPS_BASE_URL or ACCESSOPS_URL.
ACCESSOPS_BASE_URL=

# Supply ACCESSOPS_SERVICE_TOKEN, or configure SERVICE_AUTH_PRIVATE_KEY_PEM
# or SERVICE_AUTH_SECRET for the helper to mint a short-lived service token.
ACCESSOPS_SERVICE_TOKEN=
SERVICE_AUTH_PRIVATE_KEY_PEM=
SERVICE_AUTH_SECRET=
SERVICE_AUTH_KID=

# Optional request proof secret shared with the trusted gateway.
GATEWAY_ACTOR_TRUST_SECRET=

# Optional JSON object mapping exact organization IDs to installed-app IDs.
ACCESSOPS_APPLICATION_INSTALLATIONS=

# Application integration flag; production route guards must fail closed unless enabled.
ACCESSOPS_APPLICATION_AUTHORIZATION_ENABLED=