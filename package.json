{
  "name": "@cynayd/accessops-first-party-app-connnect-sdk",
  "version": "0.6.0-rc.9",
  "private": true,
  "description": "CYNAYD first-party One authentication, delegation and AccessOps authorization SDK.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.17"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SOURCE-MANIFEST.json",
    "AGENTS.md",
    "docs",
    "examples",
    "tooling/registration",
    "CHANGELOG.md",
    "SECURITY.md",
    "src",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "jest --runInBand",
    "example": "npm run build && node examples/connect.cjs",
    "test:registration": "node --test test/registration/workflow.test.cjs",
    "registration": "node tooling/registration/register.cjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.10",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3"
  }
}
